# Copy to ~/.config/fish/secrets.fish (chmod 600) and fill in. Never commit the real file.
set -gx NPM_TOKEN ""
set -gx GITHUB_NPM_TOKEN ""
set -gx PLEX_ZD_PLEX_URL ""
set -gx PLEX_ZD_PLEX_TOKEN ""
set -gx PLEX_ZD_SSH_HOST ""
set -gx PLEX_ZD_SSH_PORT ""
set -gx PLEX_ZD_SSH_USERNAME ""
set -gx PLEX_ZD_SSH_PASSWORD ""
set -gx PLEX_ZD_LOCAL_PATH "$HOME/Downloads/plex"
