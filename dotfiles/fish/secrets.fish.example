# Copy to ~/.config/fish/secrets.fish (chmod 600) and fill in. Never commit the real file.
# Holds secrets and machine-local settings that should not be in the repo.
# install.sh prompts for any empty value, using the comment after it as the description.
set -gx NPM_TOKEN "" # npmjs.com access token for installing/publishing npm packages
set -gx GITHUB_NPM_TOKEN "" # GitHub token with read:packages, for work packages on npm.pkg.github.com
set -gx PLEX_ZD_PLEX_URL "" # Plex server URL, e.g. http://host:32400
set -gx PLEX_ZD_PLEX_TOKEN "" # Plex auth token (X-Plex-Token) for that server
set -gx PLEX_ZD_SSH_HOST "" # SSH hostname or IP of the Plex server
set -gx PLEX_ZD_SSH_PORT "" # SSH port of the Plex server, usually 22
set -gx PLEX_ZD_SSH_USERNAME "" # SSH username on the Plex server
set -gx PLEX_ZD_SSH_PASSWORD "" # SSH password for that user
set -gx PLEX_ZD_LOCAL_PATH "$HOME/Downloads/plex" # Local folder for Plex downloads
set -gx CLAUDE_WORK_DIR "" # Directory tree that uses the work Claude Code subscription, e.g. ~/Work/acme
